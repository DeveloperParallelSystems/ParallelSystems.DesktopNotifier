<Window x:Class="ParallelSystems.DesktopNotifier.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parallel Systems — Timesheet" Width="1120" Height="650" MinWidth="900" MinHeight="520"
        Icon="/Assets/logo-mark.ico" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="BrowserHost"/>
        <Border x:Name="Recovery" Background="{StaticResource PaperBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
                <TextBlock Text="Parallel Systems Timesheet" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <TextBlock x:Name="RecoveryMessage" Text="Loading your timesheet…" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
