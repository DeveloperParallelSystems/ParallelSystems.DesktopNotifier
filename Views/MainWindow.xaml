<Window x:Class="ParallelSystems.DesktopNotifier.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParallelSystems.DesktopNotifier.Views"
        Title="Parallel Systems — Manual Timesheet" Width="1120" Height="650"
        Icon="/Assets/logo-mark.ico" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PaperBrush}">
    <Window.Resources>
        <local:ExistingWorkDateConverter x:Key="ExistingWorkDateConverter"/>
        <Style x:Key="WorkDateCalendarDay" TargetType="CalendarDayButton">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ExistingWorkDateConverter}">
                            <Binding/>
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Calendar}"/>
                            <Binding Path="DataContext.ExistingDatesVersion" RelativeSource="{RelativeSource AncestorType=Calendar}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="ToolTip" Value="Timesheet already added"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkDateCalendar" TargetType="Calendar">
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource WorkDateCalendarDay}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5C9A4A"/><GradientStop Color="#294A69" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
        <Grid Grid.Row="1" Margin="26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/>
                <StackPanel>
                    <TextBlock Text="MANUAL TIMESHEET" Style="{StaticResource EyebrowText}" Margin="0,0,0,5"/>
                    <TextBlock Text="Record your workday" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Add the sessions you want included in your timesheet." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WORK DATE" Style="{StaticResource EyebrowText}"/>
                        <DatePicker IsEnabled="{Binding IsEditingEnabled}" SelectedDate="{Binding SelectedWorkDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayDateEnd="{Binding LatestWorkDate, Mode=OneWay}" CalendarStyle="{StaticResource WorkDateCalendar}"
                                    CalendarOpened="WorkDatePickerCalendarOpened" Margin="0,7,16,0"/>
                        <TextBlock Text="{Binding SelectedDateStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,16,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0">
                        <TextBlock Text="DAY TARGET" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding RequiredDuration}" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                        <TextBlock Text="MANUAL TOTAL" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{Binding TotalDuration}" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding RemainingDuration, StringFormat={}{0} remaining}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0" IsEnabled="{Binding IsEditingEnabled}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,10">
                        <Button DockPanel.Dock="Right" Content="+ Add session" Command="{Binding AddManualCommand}" Style="{StaticResource TableButton}"/>
                        <StackPanel>
                            <TextBlock Text="WORK SESSIONS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="Choose a project, duration, category, client, and level for each entry." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ManualSessions}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Project" Width="2*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" TextSearch.TextPath="Name" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Duration" Width="125">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding EngagedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="{}{0:hh\:mm}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Task category *" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.TaskCategories, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding TaskCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Client *" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.Clients, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" TextSearch.TextPath="Name" Text="{Binding ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Select a client or type a new client name"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Level" Width="1*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                            <DataGridTemplateColumn Width="82">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Command="{Binding DataContext.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource TableButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Save manual timesheet" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ApplicationVersion}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Desktop Notifier version"/>
                <Border BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,4,12,4">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource GreenSoftBrush}"/><Setter Property="BorderBrush" Value="#D3E5C9"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="#FBEAE6"/><Setter Property="BorderBrush" Value="#ECCAC2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Border>
            </DockPanel>
        </Grid>

        <Border Grid.RowSpan="2" Panel.ZIndex="10" Background="#B3F4F6F2"
                Visibility="{Binding IsLoadingData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel>
                    <TextBlock Text="Loading timesheet data..." FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource GreenBrush}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
