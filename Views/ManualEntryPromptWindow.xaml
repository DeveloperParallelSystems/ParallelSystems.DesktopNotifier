<Window x:Class="ParallelSystems.DesktopNotifier.Views.ManualEntryPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record today's work" Width="720" Height="760" MinWidth="600" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        Background="#F4F6F2" Loaded="Window_Loaded" Closing="Window_Closing">
    <Border BorderBrush="#5C9A4A" BorderThickness="0,4,0,0" Background="#F4F6F2">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="TIME TO RECORD YOUR WORK" Foreground="#3D6B30" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="Today's work session" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock Text="There are no timesheet entries for today. We started with yesterday's sessions so you can review and adjust them." TextWrapping="Wrap" Foreground="#56645B" Margin="0,5,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.IsEnabled>
                        <Binding Path="IsEditingEnabled"/>
                    </ItemsControl.IsEnabled>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#DDE4DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="Project" FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                        <TextBlock Text="Client" FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding DataContext.Clients, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="Hours" FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding DataContext.HourOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="Label" SelectedValuePath="Seconds" SelectedValue="{Binding EngagedSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                        <TextBlock Text="Level" FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,4,0,0" IsEditable="True" ItemsSource="{Binding DataContext.LevelNames, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="Package name" FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,4,0,0" IsEditable="True" ItemsSource="{Binding DataContext.PackageNames, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                                        <TextBlock Text="Task category" FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,4,0,0" IsEditable="True" ItemsSource="{Binding DataContext.TaskCategories, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Text="{Binding TaskCategory, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                                        <TextBox Margin="0,4,0,0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"/>
                                    </StackPanel>
                                    <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Remove session" Click="RemoveSession_Click" HorizontalAlignment="Right" Padding="10,6"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Grid.Row="0" Text="Loading yesterday's sessions…" Foreground="#56645B" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <Button Content="Add another session" Click="AddSession_Click" IsEnabled="{Binding IsEditingEnabled}" Padding="12,9" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Continue in main window" Click="Continue_Click" IsEnabled="{Binding IsEditingEnabled}" Padding="12,9" Margin="0,0,8,0"/>
                        <Button x:Name="SubmitButton" Content="Submit today's timesheet" Click="Submit_Click" Padding="14,9" Background="#3D6B30" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
