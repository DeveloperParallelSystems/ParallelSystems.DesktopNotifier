<Window x:Class="ParallelSystems.DesktopNotifier.Views.NotificationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification schedule"
        Icon="/Assets/logo-mark.ico"
        Width="450" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#1E2B23" BlurRadius="28" ShadowDepth="8" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12,12,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#5C9A4A"/>
                        <GradientStop Color="#294A69" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Grid.Row="1" Margin="26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="✕" Padding="8,4" Margin="8,0,0,0"
                            FontSize="14" Click="CancelClicked" ToolTip="Close"/>
                    <StackPanel>
                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Reminder schedule" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="MORNING" Style="{StaticResource EyebrowText}" Margin="4,0,0,4"/>
                        <TextBox x:Name="MorningTimeTextBox" ToolTip="Use 24-hour HH:mm format"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="EVENING" Style="{StaticResource EyebrowText}" Margin="4,0,0,4"/>
                        <TextBox x:Name="EveningTimeTextBox" ToolTip="Use 24-hour HH:mm format"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Text="Use 24-hour HH:mm format. Morning must be before 12:00; evening must be 12:00 or later."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,0,0,18"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClicked"/>
                    <Button Content="Save schedule" MinWidth="140" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="SaveClicked"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
