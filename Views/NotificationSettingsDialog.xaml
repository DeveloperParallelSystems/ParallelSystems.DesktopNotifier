<Window x:Class="ParallelSystems.DesktopNotifier.Views.NotificationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParallelSystems.DesktopNotifier.Views"
        Title="Settings"
        Icon="/Assets/logo-mark.ico"
        Width="580" SizeToContent="Height" MaxHeight="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#1E2B23" BlurRadius="28" ShadowDepth="8" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12,12,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#5C9A4A"/>
                        <GradientStop Color="#294A69" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Grid.Row="1" Margin="26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="✕" Padding="8,4" Margin="8,0,0,0"
                            FontSize="14" Click="CancelClicked" ToolTip="Close"/>
                    <StackPanel>
                        <TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                <TabItem Header="Notifications">
                <StackPanel Margin="12,20,12,8">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="MORNING" Style="{StaticResource EyebrowText}" Margin="4,0,0,4"/>
                        <TextBox x:Name="MorningTimeTextBox" ToolTip="Use 24-hour HH:mm format"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="EVENING" Style="{StaticResource EyebrowText}" Margin="4,0,0,4"/>
                        <TextBox x:Name="EveningTimeTextBox" ToolTip="Use 24-hour HH:mm format"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Use 24-hour HH:mm format. Morning must be before 12:00; evening must be 12:00 or later."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,0,0,18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClicked"/>
                    <Button Content="Save schedule" MinWidth="140" Style="{StaticResource PrimaryButton}"
                            Click="SaveClicked"/>
                </StackPanel>
                </StackPanel>
                </TabItem>
                <TabItem Header="Account">
                    <StackPanel Margin="12,16,12,8">
                        <TextBlock Text="Sign in with your timesheet portal account to manage project settings."
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="AccountForm">
                            <TextBlock Text="Username"/>
                            <TextBox x:Name="UsernameInput" MaxLength="256" Margin="0,4,0,12"/>
                            <TextBlock Text="Password"/>
                            <PasswordBox x:Name="PasswordInput" Margin="0,4,0,12" Padding="8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Sign in" Click="SignInClicked"/>
                                <Button Content="Sign out" Click="SignOutClicked"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="AccountStatusText" Text="Not signed in." TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </TabItem>
                <TabItem x:Name="ProjectManagementTab" Header="Project management" Visibility="Collapsed">
                    <local:CatalogEditor x:Name="ProjectCatalogEditor"/>
                </TabItem>
                <TabItem Header="Personal information">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel Margin="12,16,12,8">
                            <TextBlock Text="Edit the employee record whose identity key matches this computer name."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock x:Name="ProfileStatusText" Text="Loading personal information…"
                                       TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="ReloadProfileButton" Content="Reload personal information" HorizontalAlignment="Left"
                                    Click="ReloadProfileClicked" Margin="0,0,0,10"/>
                            <StackPanel x:Name="ProfileForm" IsEnabled="False">
                                <TextBlock Text="First name"/>
                                <TextBox x:Name="FirstNameTextBox" MaxLength="100" Margin="0,2,0,8"/>
                                <TextBlock Text="Middle name"/>
                                <TextBox x:Name="MiddleNameTextBox" MaxLength="100" Margin="0,2,0,8"/>
                                <TextBlock Text="Last name"/>
                                <TextBox x:Name="LastNameTextBox" MaxLength="100" Margin="0,2,0,8"/>
                                <TextBlock Text="Suffix"/>
                                <TextBox x:Name="SuffixTextBox" MaxLength="30" Margin="0,2,0,8"/>
                                <TextBlock Text="Gender"/>
                                <TextBox x:Name="GenderTextBox" MaxLength="30" Margin="0,2,0,8"/>
                                <TextBlock Text="Birth date"/>
                                <DatePicker x:Name="BirthDatePicker" Margin="0,2,0,8"/>
                                <TextBlock Text="Civil status"/>
                                <TextBox x:Name="CivilStatusTextBox" MaxLength="50" Margin="0,2,0,8"/>
                                <TextBlock Text="Nationality"/>
                                <TextBox x:Name="NationalityTextBox" MaxLength="100" Margin="0,2,0,8"/>
                                <TextBlock Text="Address"/>
                                <TextBox x:Name="AddressTextBox" MaxLength="1000" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="70" Margin="0,2,0,12"/>
                                <Button Content="Save personal information" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" Click="SaveProfileClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
