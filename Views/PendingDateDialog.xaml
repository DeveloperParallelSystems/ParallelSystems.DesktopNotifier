<Window x:Class="ParallelSystems.DesktopNotifier.Views.PendingDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a past work date" Icon="/Assets/logo-mark.ico"
        Width="430" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect><DropShadowEffect Color="#1E2B23" BlurRadius="28" ShadowDepth="8" Opacity="0.22"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12,12,0,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5C9A4A"/><GradientStop Color="#294A69" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Grid Grid.Row="1" Margin="26,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="×" Padding="8,4" Click="CancelClicked" ToolTip="Close"/>
                    <StackPanel>
                        <TextBlock Text="MANUAL WORK DAY" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Add a past date" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Choose the day you want to complete manually. This will not create a Revit daily-work record."
                           TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="WORK DATE" Style="{StaticResource EyebrowText}" Margin="4,0,0,3"/>
                    <DatePicker x:Name="WorkDatePicker" SelectedDateFormat="Long"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="CancelClicked"/>
                    <Button Content="Add pending date" MinWidth="145" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ConfirmClicked"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
